            --accent-glow: rgba(122, 162, 247, 0.3);
            --success: #9ece6a;
            --fg: #c0caf5;
            --fg-dim: #7982a9;
            --border: #414868;
        }}
        * {{ box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }}
        body {{
            background: var(--bg);
            color: var(--fg);
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }}
        .container {{ width: 100%; max-width: 460px; }}
        header {{ text-align: center; margin-bottom: 24px; }}
        h1 {{ font-size: 26px; color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; }}
        p.subtitle {{ color: var(--fg-dim); font-size: 14px; margin-top: 6px; }}
        .card {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.35);
            margin-bottom: 20px;
        }}
        .dropzone {{
            border: 2px dashed var(--accent);
            border-radius: 14px;
            padding: 36px 16px;
            text-align: center;
            background: rgba(122, 162, 247, 0.06);
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }}
        .dropzone:active {{ background: var(--accent-glow); transform: scale(0.98); }}
        .dropzone-icon {{ font-size: 52px; margin-bottom: 12px; }}
        .dropzone-text {{ font-size: 17px; font-weight: 700; color: #fff; }}
        .dropzone-sub {{ font-size: 13px; color: var(--fg-dim); margin-top: 6px; }}
        #fileInput {{ display: none; }}
        #progressContainer {{ display: none; margin-top: 20px; }}
        .progress-bar-bg {{ background: var(--border); height: 12px; border-radius: 6px; overflow: hidden; }}
