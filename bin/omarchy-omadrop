                {"".join([f'''<div class="file-item"><div class="file-info"><span class="file-name">📄 {f["name"]}</span><span class="file-size">{f["size"]}</span></div><a href="/download/{urllib.parse.quote(f["name"])}" class="dl-btn t-dl-btn" download>Download</a></div>''' for f in send_files])}
