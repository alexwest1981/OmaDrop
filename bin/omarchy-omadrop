            </div>
        </div>

        <div class="card" id="downloadCard" style="{'display: block;' if send_files else 'display: none;'}">
            <h2 id="t-get-title" style="font-size: 17px; margin-bottom: 14px; color: #fff; display: flex; align-items: center; gap: 6px;">💻 Get from PC</h2>
