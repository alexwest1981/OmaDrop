import os
import sys
import re
import time
import socket
import json
import urllib.parse
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler

PORT = 5380
BASE_DIR = os.path.expanduser("~/Downloads/OmaDrop")
RECEIVED_DIR = os.path.join(BASE_DIR, "Received")
SEND_DIR = os.path.join(BASE_DIR, "Send")
QR_PATH = "/tmp/omadrop-qr.png"
PID_FILE = "/tmp/omadrop.pid"

os.makedirs(RECEIVED_DIR, exist_ok=True)
os.makedirs(SEND_DIR, exist_ok=True)

# ------------------------------------------------------------------------------
# Server-side Notifications i18n
# ------------------------------------------------------------------------------
NOTIF_STRINGS = {
    "en": {"received_single": "📥 OmaDrop: 1 new file received", "received_multi": "📥 OmaDrop: {count} new files received"},
    "sv": {"received_single": "📥 OmaDrop: 1 ny fil mottagen", "received_multi": "📥 OmaDrop: {count} nya filer mottagna"},
    "nl": {"received_single": "📥 OmaDrop: 1 nieuw bestand ontvangen", "received_multi": "📥 OmaDrop: {count} nieuwe bestanden ontvangen"},
    "ja": {"received_single": "📥 OmaDrop: 1件のファイルを受信しました", "received_multi": "📥 OmaDrop: {count}件のファイルを受信しました"},
    "de": {"received_single": "📥 OmaDrop: 1 neue Datei empfangen", "received_multi": "📥 OmaDrop: {count} neue Dateien empfangen"},
    "fr": {"received_single": "📥 OmaDrop: 1 nouveau fichier reçu", "received_multi": "📥 OmaDrop: {count} nouveaux fichiers reçus"},
    "es": {"received_single": "📥 OmaDrop: 1 archivo nuevo recibido", "received_multi": "📥 OmaDrop: {count} archivos nuevos recibidos"},
    "zh": {"received_single": "📥 OmaDrop: 收到 1 个新文件", "received_multi": "📥 OmaDrop: 收到 {count} 个新文件"}
}

def get_system_lang():
    lang_env = os.environ.get("LANG", "en_US.UTF-8").split(".")[0].split("_")[0].lower()
    return lang_env if lang_env in NOTIF_STRINGS else "en"

def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def generate_qr(url):
    try:
        subprocess.run(["qrencode", "-s", "6", "-m", "2", "-o", QR_PATH, url], check=False)
    except Exception:
        pass

def parse_multipart(rfile, content_type, content_length, save_dir):
    m = re.search(r'boundary=(.+)', content_type)
    if not m:
        return []
    boundary = m.group(1).strip('"\'').encode('utf-8')
    delimiter = b'--' + boundary

    saved_files = []
    data = rfile.read(content_length)
    parts = data.split(delimiter)

    for part in parts:
        if not part or part.startswith(b'--') or b'\r\n\r\n' not in part:
            continue
        
        header_bytes, body = part.split(b'\r\n\r\n', 1)
        if body.endswith(b'\r\n'):
            body = body[:-2]

        headers_str = header_bytes.decode('utf-8', errors='replace')
        fn_match = re.search(r'filename="([^"]+)"', headers_str)
        if fn_match:
            filename = os.path.basename(fn_match.group(1))
            if not filename:
                continue
            
            dest_path = os.path.join(save_dir, filename)
            counter = 1
            base, ext = os.path.splitext(filename)
            while os.path.exists(dest_path):
                dest_path = os.path.join(save_dir, f"{base}_{counter}{ext}")
                counter += 1

            with open(dest_path, "wb") as f:
                f.write(body)
            saved_files.append(os.path.basename(dest_path))

    return saved_files

class OmaDropHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_HEAD(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/" or parsed.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()

            send_files = []
            if os.path.exists(SEND_DIR):
                for f in os.listdir(SEND_DIR):
                    full_p = os.path.join(SEND_DIR, f)
                    if os.path.isfile(full_p):
                        sz = os.path.getsize(full_p)
                        sz_str = f"{sz / 1024:.1f} KB" if sz < 1024*1024 else f"{sz / (1024*1024):.1f} MB"
                        send_files.append({"name": f, "size": sz_str})

            html = f"""<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
